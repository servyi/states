#!/usr/bin/env bash
# pre-push hook: enforces the review-discipline sentence in the last commit
# message. Install with: cp tools/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
set -u

MAGIC="I reviewed that I did not again violate the basic instructions."

INSTRUCTIONS=$(cat <<'EOF'
ALL STANDING INSTRUCTIONS AND CRITICISMS (not overridden by later ones):

1.  HANDLES FIRST: in fan-outs, convert split items into Handles and collect
    them BEFORE spawning threads; workers only ever see Handles, never the
    split's borrows. ("I just told you for the 10th time not to do" this.)
2.  NO SHARED-BORROW REVERTS: access goes through Deref/DerefMut (Handle and
    CheckpointGuard alike), not node()/block_and_get-style shared borrows.
3.  Split produces disjoint children via a parallel iterator (rayon); avoid
    raw `this` pointers and unsafe casts — use DerefMut instead.
4.  Don't hand-roll parsers — use std or an existing crate (rustc_lexer for
    the lint driver). Custom parsers only with supervisor sign-off, isolated
    in a submodule headed by `/// WARNING: CUSTOM PARSER ...`.
5.  expect() must state WHY the failure is impossible; if the failure is
    possible, handle or propagate it instead of expecting.
6.  Mutex poisoning decision tree: expect (impossible: pure ops only),
    into_inner + written argument (state provably still valid), propagate,
    or log + rebuild recoverable state. Never bare unwrap().
7.  allow/expect of panic/unwrap lints is test-only (cfg(test)); production
    code handles or propagates (enforced by the non_test_panic_allow lint).
8.  No [lints] tables in manifests — the policy is the CI flag list
    (enforced by the workspace_lints_table lint).
9.  Unsound-from-safe constructors carry #[servyi::unsound_constructor] with
    /// SAFETY preconditions at the struct and // SAFETY arguments at every
    construction site (enforced by the unsound_constructor lint).
10. Reuse, don't duplicate: one implementation of the handshake, the
    request, the release; thin interfaces over a single impl.
11. Precise names (pending_request, join_handle, …) and explicit lifetimes.
12. Comments must match the code that exists — delete legacy comments for
    deleted code; every comment re-read in context before pushing.
13. CI green before review: run the flag-list clippy, the driver (all three
    denies), the full test suite, and rustdoc locally before pushing.
14. Fan-out results live INSIDE the node (actions store them); fanout
    returns nothing.
15. Concurrent requesters serialize via the unit mutex held by the guard;
    a Closed mutator means free access, not failure; no deadlocks, ever.
16. Unsafe Send/Sync impls need T: Send (the data crosses threads).
17. Tree Borrows is the memory model for Miri verification.
EOF
)

while read local_ref local_sha remote_ref remote_sha; do
    msg=$(git log -1 --format=%B "$local_sha" 2>/dev/null || true)
    if [[ "$msg" != *"$MAGIC"* ]]; then
        cat >&2 <<ERR
PUSH ABORTED: the last commit message does not contain the sentence:
  "$MAGIC"

Re-read the instructions below, verify the commit against every one of
them, amend the message to include the sentence, and push again.

$INSTRUCTIONS
ERR
        exit 1
    fi
done

exit 0
